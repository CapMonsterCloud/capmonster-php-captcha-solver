{
    "name": "capmonstercloud/capmonster-client",
    "description": "Official CapMonster Cloud PHP SDK: captcha solver & captcha bypass for reCAPTCHA v2/v3/Enterprise, Cloudflare Turnstile, DataDome, GeeTest, Amazon WAF, FunCaptcha and 20+ captcha types. A 2captcha and capsolver alternative.",
    "type": "library",
    "license": "MIT",
    "keywords": ["captcha", "capmonster", "captcha-solver", "captcha-bypass", "recaptcha", "turnstile", "geetest", "datadome", "amazon-waf", "funcaptcha", "2captcha-alternative", "capsolver-alternative"],
    "homepage": "https://capmonster.cloud",
    "support": {
        "docs": "https://docs.capmonster.cloud",
        "source": "https://github.com/CapMonsterCloud/capmonster-php-captcha-solver"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "CapMonsterCloud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CapMonsterCloud\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
