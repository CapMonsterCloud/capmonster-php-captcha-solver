{
    "name": "capmonstercloud/capmonster-client",
    "description": "PHP client for the CapMonster Cloud captcha-solving API",
    "type": "library",
    "license": "MIT",
    "keywords": ["captcha", "capmonster", "recaptcha", "turnstile", "captcha-solver"],
    "homepage": "https://capmonster.cloud",
    "support": {
        "docs": "https://docs.capmonster.cloud",
        "source": "https://github.com/CapMonsterCloud/capmonster-php-captcha-solver"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "CapMonsterCloud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CapMonsterCloud\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
